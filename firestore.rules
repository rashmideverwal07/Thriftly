rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Validates that the user's email belongs strictly to the official IGDTUW domain
    function isCollegeEmail() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@igdtuw[.]ac[.]in$');
    }

    // ==========================================
    // PRODUCT LISTINGS
    // ==========================================
    match /products/{productId} {

      // Anyone can view marketplace listings
      allow read: if true;

      // Only verified users can create their own listings
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.status == "Available";

      // Only the verified owner can update their product
      allow update: if request.auth != null
        && request.auth.token.email_verified == true
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId;

      // Only the owner can delete their product
      allow delete: if request.auth != null
        && resource.data.sellerId == request.auth.uid;
    }

    // ==========================================
    // STUDENT WISHLISTS
    // ==========================================
    match /users/{userId}/wishlist/{productId} {

      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // ==========================================
    // BUYER-SELLER REQUESTS
    // ==========================================
    match /requests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid);

      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.status == "Pending";

      allow update: if request.auth != null
        && request.auth.token.email_verified == true
        && (
          (
            // Seller accepts or declines a pending request
            resource.data.status == "Pending" && resource.data.sellerId == request.auth.uid
            && request.resource.data.status in ["Accepted", "Declined"]
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status", "respondedAt"])
          )
          ||
          (
            // Buyer cancels a pending request
            resource.data.status == "Pending"
            && resource.data.buyerId == request.auth.uid
            && request.resource.data.status == "Cancelled"
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status", "cancelledAt"])
          )
          ||
          (
            // Seller completes an accepted request
            resource.data.status == "Accepted"
            && resource.data.sellerId == request.auth.uid
            && request.resource.data.status == "Completed"
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status", "completedAt"])
          )
        );

      allow delete: if false;
    }

    // ==========================================
    // BUYER-SELLER MESSAGING
    // ==========================================
    match /conversations/{conversationId} {

      // Only the buyer and seller can view the conversation
      allow read: if request.auth != null
        && (resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
        );

      // Only verified buyers can start conversations
      // The seller must actually own the product
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.productId is string
        && get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.sellerId == request.resource.data.sellerId;

      // Participants can update latest-message and read-status information
      allow update: if request.auth != null
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
        )
        && (
          // Update latest-message information
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["lastMessage", "lastSenderId", "updatedAt"])
            && request.resource.data.lastSenderId == request.auth.uid
            && request.resource.data.lastMessage is string
          )
          ||
          // Buyer updates only their own read timestamp
          (resource.data.buyerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["buyerLastReadAt"])
          )
          ||
          // Seller updates only their own read timestamp
          (
            resource.data.sellerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["sellerLastReadAt"])
          )
        );

      allow delete: if false;

      // INDIVIDUAL MESSAGES
      match /messages/{messageId} {

        // Only conversation participants can read messages
        allow read: if request.auth != null
          && (
            get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.buyerId == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.sellerId == request.auth.uid
          );

        // Participants can send messages
        allow create: if request.auth != null
          && request.auth.token.email_verified == true
          && (get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.buyerId == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.sellerId == request.auth.uid
          )
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;

        // Messages cannot be edited or deleted
        allow update, delete: if false;
      }
    }

  }
}
